{
  "name": "rcrotations-workshop",
  "productName": "RCRotations Workshop",
  "version": "1.2.0",
  "description": "Edit WoWSims rotations and save them straight into RCRotations.",
  "author": "Raw Card",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/wow.test.js",
    "dist": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.rawcard.rcrotations.workshop",
    "productName": "RCRotations Workshop",
    "files": [
      "main.js",
      "preload.js",
      "wow.js",
      "renderer/**",
      "data/**",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "RCRotations-Workshop-${version}.exe"
    }
  }
}
